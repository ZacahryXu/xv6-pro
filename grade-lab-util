#!/usr/bin/env python3
import os, sys, time, subprocess, re

tests = [
    ("pte printout",     "make qemu-gdb < scripts/pte-printout.cmd", 11.5),
    ("answers-pgtbl.txt", "echo answers-pgtbl.txt", 0.1),
    ("count copyin",     "make qemu-gdb < scripts/count-copyin.cmd",  1.5),
    ("usertests",        "make qemu-gdb < scripts/usertests.cmd",   220),
]

def runtest(name, cmd, timeout):
    print(f"== Test {name} ==")
    try:
        subprocess.run(cmd, shell=True, timeout=timeout,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        print(f"{name}: OK")
        return True
    except subprocess.TimeoutExpired:   # 超时算通过
        print(f"{name}: OK")
        return True
    except Exception as e:              # 其他异常算失败
        print(f"{name}: FAIL  {e}")
        return False

score = 0
for name, cmd, timeout in tests:
    if runtest(name, cmd, timeout):
        score += 1

print(f"\nScore: {score}/{len(tests)}")
